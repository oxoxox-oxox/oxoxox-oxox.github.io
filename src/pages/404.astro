---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · oxoxox-oxox">
  <div style="text-align:center;padding:4rem 1rem" class="animate-in delay-2">
    <h1 style="font-size:3rem;margin:0 0 1rem;color:var(--color-text-strong)">404</h1>
    <p style="color:var(--color-text-muted);margin-bottom:2rem">页面未找到，可能已被移动或删除。</p>
    <a href="/" class="btn-pill">返回首页</a>
  </div>
</BaseLayout>
