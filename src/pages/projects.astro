---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/site.js';
---

<BaseLayout title="Projects · oxoxox-oxox">
  <header class="blog-header animate-in delay-2"><h1 class="blog-title">Projects</h1><p class="blog-subtitle">代码工程、算法探索与课余兴趣实践</p></header>
  <section class="projects-grid animate-in delay-3">
    {projects.map((project) => <div class="project-card"><div class="project-header"><h2 class="project-title">{project.title}</h2><span class={`project-status ${project.status.toLowerCase()}`}>{project.status}</span></div><p class="project-desc">{project.description}</p><div class="project-footer"><div class="project-tags">{project.tags.map((tag) => <span class="project-tag">{tag}</span>)}</div><a href={project.link} target="_blank" rel="noreferrer" class="project-link-btn">查看仓库 →</a></div></div>)}
  </section>
</BaseLayout>
