---
import '../styles/main.css';
import { getCollection } from 'astro:content';
import { projects } from '../data/site.js';
const { title = "oxoxox-oxox's ink", description = '个人主页与技术随笔博客' } = Astro.props;
const posts = await getCollection('posts', ({ data }) => data.published);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <script type="application/json" id="site-search-data" set:html={JSON.stringify(posts.map(({ slug, data }) => ({ slug, title: data.title, tag: data.tag || '', excerpt: data.excerpt })))}></script>
    <script type="application/json" id="project-search-data" set:html={JSON.stringify(projects)}></script>
    <div class="page-wrapper">
      <nav class="navbar animate-in delay-1">
        <a href="/" class="nav-brand">oxoxox-oxox's ink</a>
        <div class="nav-menu">
          <a href="/blog/" class:list={['nav-link', Astro.url.pathname.startsWith('/blog') && 'active']}>Blog</a>
          <a href="/projects/" class:list={['nav-link', Astro.url.pathname === '/projects/' && 'active']}>Projects</a>
          <a href="/links/" class:list={['nav-link', Astro.url.pathname === '/links/' && 'active']}>Links</a>
          <a href="/" class:list={['nav-link', Astro.url.pathname === '/' && 'active']}>About</a>
          <button class="nav-icon-btn" data-open-search title="搜索 (Ctrl+K)" aria-label="Search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
          <button class="nav-icon-btn" data-open-device title="系统信息与设备" aria-label="Device">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </button>
        </div>
      </nav>
      <main><slot /></main>
      <footer class="footer animate-in delay-4"><p>© {new Date().getFullYear()} oxoxox-oxox · Built with Astro</p></footer>
    </div>
    <div class="modal-backdrop" data-search-modal hidden>
      <div class="modal-dialog" role="dialog" aria-modal="true" aria-label="搜索">
        <div class="modal-header">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="search" class="modal-search-input" placeholder="搜索文章、项目、技术栈... (按 ESC 退出)" data-search-input />
          <button class="modal-close-btn" data-close-search aria-label="关闭">×</button>
        </div>
        <div class="modal-results" data-search-results></div>
      </div>
    </div>
    <div class="modal-backdrop" data-device-modal hidden>
      <div class="modal-dialog terminal-dialog" role="dialog" aria-modal="true" aria-label="设备信息">
        <div class="terminal-header"><div class="terminal-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div><span class="terminal-title">device@oxoxox-oxox: ~</span><button class="modal-close-btn" data-close-device aria-label="关闭">×</button></div>
        <div class="terminal-body">
          <div class="terminal-line"><span class="terminal-prompt">$</span> neofetch --short</div>
          <div class="terminal-info"><p><span class="info-key">User:</span> oxoxox-oxox</p><p><span class="info-key">Major:</span> Computer Science @ UNNC</p><p><span class="info-key">Location:</span> China / Ningbo</p><p><span class="info-key">Framework:</span> Astro</p><p><span class="info-key">Routing:</span> Static routes (GitHub Pages)</p><p><span class="info-key">Markdown:</span> Astro Content Collections</p><p><span class="info-key">Status:</span> 迷茫中探索，热衷于构建高效项目</p></div>
          <div class="terminal-line" style="margin-top:1.2rem"><span class="terminal-prompt">$</span> echo "Welcome to oxoxox-oxox's digital space!"</div>
          <div class="terminal-output">Welcome to oxoxox-oxox's digital space!</div>
        </div>
      </div>
    </div>
    <script is:inline>
      const closeAll = () => document.querySelectorAll('[data-search-modal], [data-device-modal]').forEach((el) => { el.hidden = true; });
      const searchModal = document.querySelector('[data-search-modal]');
      const deviceModal = document.querySelector('[data-device-modal]');
      const searchInput = document.querySelector('[data-search-input]');
      const results = document.querySelector('[data-search-results]');
      const posts = JSON.parse(document.getElementById('site-search-data')?.textContent || '[]');
      const projects = JSON.parse(document.getElementById('project-search-data')?.textContent || '[]');
      const renderResults = () => {
        const query = searchInput.value.trim().toLowerCase();
        const matchingPosts = posts.filter((item) => !query || `${item.title} ${item.tag} ${item.excerpt}`.toLowerCase().includes(query));
        const matchingProjects = projects.filter((item) => query && `${item.title} ${item.description} ${item.tags.join(' ')}`.toLowerCase().includes(query));
        const group = (title, items, href, sub, tag) => items.length ? `<section class="modal-section"><div class="modal-section-title">${title}</div>${items.map((item) => `<a class="modal-result-item" href="${href(item)}"><span class="modal-result-main"><span class="modal-result-title">${item.title}</span><span class="modal-result-sub">${item[sub]}</span></span><span class="modal-result-tag">${Array.isArray(item[tag]) ? item[tag].slice(0, 2).join(', ') : item[tag] || ''}</span></a>`).join('')}</section>` : '';
        results.innerHTML = group('文章 (Blog)', matchingPosts, (item) => `/blog/${item.slug}/`, 'excerpt', 'tag') + group('项目 (Projects)', matchingProjects, () => '/projects/', 'description', 'tags');
        if (!results.innerHTML) results.innerHTML = '<div class="modal-empty">没有找到相关内容</div>';
      };
      document.querySelector('[data-open-search]').addEventListener('click', () => { closeAll(); searchModal.hidden = false; renderResults(); searchInput.focus(); });
      document.querySelector('[data-close-search]').addEventListener('click', closeAll);
      document.querySelector('[data-open-device]').addEventListener('click', () => { closeAll(); deviceModal.hidden = false; });
      document.querySelector('[data-close-device]').addEventListener('click', closeAll);
      document.querySelectorAll('.modal-backdrop').forEach((el) => el.addEventListener('click', (event) => { if (event.target === el) closeAll(); }));
      searchInput.addEventListener('input', renderResults);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeAll(); if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); searchModal.hidden ? document.querySelector('[data-open-search]').click() : closeAll(); } });
    </script>
    <slot name="scripts" />
  </body>
</html>
